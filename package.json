{
  "name": "satispay-business",
  "version": "0.1.0-next.3",
  "description": "Unofficial TypeScript SDK for the Satispay GBusiness API (HTTP-signature auth, zero runtime dependencies)",
  "keywords": [
    "satispay",
    "gbusiness",
    "payments",
    "sdk",
    "typescript",
    "api"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "release": "pnpm build && changeset publish",
    "playground": "tsx --env-file-if-exists=playground/.env playground/test.ts"
  },
  "author": "Giovanni Mogna <mogna.giovanni@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/giomogna/satispay-business-nodejs-sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "ISC",
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
